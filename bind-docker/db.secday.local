$TTL 604800
@       IN      SOA     ns.secday.local. admin.secday.local. (
                1       ; Serial
                604800  ; Refresh
                86400   ; Retry
                2419200 ; Expire
                604800 )        ; Negative Cache TTL
; Servidor de nomes
@       IN      NS      ns.secday.local.

; Registro A
ns      IN      A       192.168.56.10
www     IN      A       192.168.56.10
pc      IN      A       192.168.56.1

; Alias
web     IN CNAME        www.secday.local.
